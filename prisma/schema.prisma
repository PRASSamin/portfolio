// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            String            @id @default(cuid()) 
  username      String            @unique
  first_name    String
  last_name     String
  full_name     String
  avatar        String?
  email         String           @unique
  public_metadata      Json?            
  role          String            @default("USER")
  connected_accounts ConnectedAccount[]
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
}

model ConnectedAccount {
  id            String    @id @default(cuid())
  user_id       String
  oauth_id      String    
  provider      String    
  provider_data Json?
  created_at    DateTime  @default(now())
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@unique([provider, oauth_id])
}

model Project {
  id          Int      @id @default(autoincrement()) 
  title       String   
  description String? 
  image       String   
  github      String?
  live        String?  
  category    String
  slug        String   @unique
  tools       Int[]
  content     String? 
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model Experience {
  id          Int      @id @default(autoincrement()) 
  company     String
  role        String
  description String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement()) 
  school      String
  degree      String
  field       String
  description String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model Blog {
  id          Int      @id @default(autoincrement()) 
  title       String
  slug        String   @unique
  tags        String[]
  content     String
  description String
  thumbnail   String?
  created_at   DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model ChatInvite {
  id          String   @id @default(uuid())
  token       String
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}
