// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model ProjectStat {
  slug       String           @id
  views      ProjectViewTracker[]
  totalViews Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ProjectViewTracker {
  id         Int      @id @default(autoincrement())
  slug       String
  visitorId  String
  lastSeen   DateTime @updatedAt
  count      Int      @default(1)
  country    String
  projectStat   ProjectStat @relation(fields: [slug], references: [slug])
  @@unique([slug, visitorId])
}

model BlogStat {
  slug       String           @id
  views      BlogViewTracker[]
  totalViews Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model BlogViewTracker {
  id         Int      @id @default(autoincrement())
  slug       String
  visitorId  String
  lastSeen   DateTime @updatedAt
  count      Int      @default(1)
  country    String
  blogStat   BlogStat @relation(fields: [slug], references: [slug])
  @@unique([slug, visitorId])
}


model Experience {
  id          Int      @id @default(autoincrement()) 
  company     String
  role        String
  description String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement()) 
  school      String
  degree      String
  field       String
  description String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}